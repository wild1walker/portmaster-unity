H("strerror's texts, by number: all the running libc knows (it may know more than the SDK's ELAST)")
printf("#define DARWIN_ERRTEXTS { \\\n");
{ char text[256]; for (int e = 0; strerror_r(e, text, sizeof text) == 0; e++) printf("    \"%s\", \\\n", text); }
printf("}\n");
