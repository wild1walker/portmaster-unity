#!/bin/bash
# First-run setup on the handheld, run by the launcher through PortMaster's patcher (made with
# `pmunity port new`, box64 route): prepares the player's own copy of the game's Linux build in
# ports/<port>/gamedata/ for box64:
#   1. the game: its folder (or the archive it came in, unpacked in place), found by `pmunity route`
#      (`pmu route` where the release has setup/pmu)
#   2. for the OpenGL ES mode: GLES 3 shader programs next to the game's OpenGL Core ones, and GLES 3
#      in its graphics API list (pmunity convert, setup/gles.json; in place, the picture unchanged)
#   3. ports/<port>/game.env: where the game is and the GL mode, for the launcher
# The game's code is not changed. Every step can be interrupted: the next launch continues.
# Log: ports/<port>/patchlog.txt. A line "PATCH_FAIL_MSG:<text>" says why the setup failed.
S="${GAMEDIR:?}/setup"; GD="$GAMEDIR/gamedata"; W="$GD/.setup"
. "$S/setup.env"

exec > >(tee -a "$GAMEDIR/patchlog.txt") 2>&1
echo "=== $(date) $PORT_TITLE setup ==="
fail() { echo "PATCH_FAIL_MSG:$1"; echo "Setup failed: $1"; echo "Patching process failed!"; exit 1; }
step() { echo; echo "== $(date +%H:%M:%S) $*"; }
hook() {                                # the port's own step at a fixed point (setup/hooks/<name>.sh)
  [ -f "$S/hooks/$1.sh" ] || return 0
  step "$PORT_TITLE: $1"
  . "$S/hooks/$1.sh" || fail "The port's $1 step failed (see patchlog.txt)."
}
lower() { echo "$1" | tr 'A-Z' 'a-z'; }
free_mb() { df -Pm "$GD" | awk 'NR==2{print $4}'; }
room() { local f; f=$(free_mb); [ -z "$f" ] || [ "$f" -gt "$1" ]; }
# a full card (or one pulled out) must stop the setup: a progress file that was not written would
# let the next launch take a half-done step for a finished one
nowrite() { fail "Could not write $1 to the card: is the card full? Free some space on it, then launch again."; }
mark() { sync; touch "$W/.step_$1" || nowrite "the setup's progress"; }   # mark <step>: what it wrote is on the card, then its marker
[ "$DEVICE_ARCH" = aarch64 ] || fail "box64 needs a 64-bit (aarch64) system (this one: $DEVICE_ARCH)."
SEVENZ="$controlfolder/7zzs.$DEVICE_ARCH"
mkdir -p "$W" || fail "Cannot write to ports/$PORT_NAME/gamedata."

# ---- the setup's tools (route and convert): setup/pmu, one static aarch64 program
# (portmaster-unity's setup-rs); a release without it ships the setup's Python instead (CPython +
# UnityPy, aarch64: setup/python.tar.gz and the converter)
if [ -f "$S/pmu" ]; then
  chmod +x "$S/pmu" 2>/dev/null
  "$S/pmu" >/dev/null 2>&1; [ $? = 2 ] || fail "The setup's tools (setup/pmu) do not run on this system (see patchlog.txt)."
  pm() { "$S/pmu" "$@"; }
else
  PY=$(ls "$W"/python/bin/python3.[0-9]* 2>/dev/null | grep -v -- '-config' | head -1)
  if [ -z "$PY" ] || ! "$PY" -c "import UnityPy, lz4" 2>/dev/null; then
    step "unpacking the setup tools"
    rm -rf "$W/python"
    # (gunzip | tar: some firmwares' BusyBox tar has no -z, e.g. muOS)
    ( set -o pipefail; gunzip -c "$S/python.tar.gz" | tar -xf - -C "$W" ) || fail "Could not unpack the setup's Python (see patchlog.txt)."
    PY=$(ls "$W"/python/bin/python3.[0-9]* 2>/dev/null | grep -v -- '-config' | head -1)
    [ -n "$PY" ] || fail "The setup's Python is incomplete."
  fi
  export PYTHONPATH="$S" PYTHONDONTWRITEBYTECODE=1
  pm() { (cd "$S" && "$PY" -m pmunity "$@"); }
fi

# ---- 1. the game: a Linux x86-64 build in gamedata/ (an archive is unpacked there first)
route_env() {   # the game `pm route` finds in gamedata/, as game.env's lines (none: no game.env)
  local e
  if e=$(pm route "$GD" --env 2>/dev/null); then
    printf '%s\n' "$e" > "$W/game.env" || nowrite "the setup's progress"
  else
    rm -f "$W/game.env"; return 1
  fi
}
# (a later launch: the game as step 1 noted it in game.env. Notes the card did not keep, or a game
# that is gone, start again from the game)
if [ -f "$W/.step_game" ]; then
  EXE=; GAME_DIR=; . "$W/game.env" 2>/dev/null
  if [ -z "$EXE" ] || [ ! -f "$GD/$GAME_DIR/$EXE" ]; then
    echo "the setup's notes of the game are incomplete (or the game's folder is gone): starting again from the game"
    rm -f "$W"/.step_* "$W/game.env"; EXE=
  fi
fi
if [ ! -f "$W/.step_game" ]; then
  if ! route_env; then
    need=$((GAME_SIZE_MB * 2 + 200))
    for a in "$GD"/*; do
      [ -f "$a" ] || continue
      case "$(lower "$a")" in
        *.zip|*.7z|*.rar|*.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2) ;;
        *.sh) head -c 65536 "$a" | grep -aqE 'Makeself|MojoSetup' || continue;;   # GOG's Linux installer (read, never run)
        *) continue;;
      esac
      room "$need" || fail "Unpacking $(basename "$a") needs about $need MB free on the card ($(free_mb) MB free)."
      step "unpacking $(basename "$a")"
      [ -x "$SEVENZ" ] || fail "PortMaster's 7-Zip is missing: update PortMaster, or unpack $(basename "$a") into gamedata/ yourself."
      case "$(lower "$a")" in
        *.tar|*.zip|*.7z|*.rar) "$SEVENZ" x -y -o"$GD" "$a" >/dev/null ;;
        *.sh) "$SEVENZ" x -tzip -y -o"$GD" "$a" >/dev/null ;;        # the zip after the installer's script
        # (the decompressor's failure counts, and what it says goes to patchlog.txt: an archive with
        # damaged data unpacks to a whole tar)
        *) ( set -o pipefail; "$SEVENZ" x -so "$a" | "$SEVENZ" x -si -ttar -y -o"$GD" >/dev/null ) ;;
      esac || fail "Could not unpack $(basename "$a") (see patchlog.txt)."
      route_env && break
    done
  fi
  hook game                               # (a port's own way to find or unpack the game)
  . "$W/game.env" 2>/dev/null
  [ -n "$EXE" ] || fail "No Linux x86-64 build of the game in ports/$PORT_NAME/gamedata: put $GAME_WHAT there, then launch again."
  echo "the game: gamedata/$GAME_DIR/$EXE, Unity $UNITY ($BACKEND), GL mode $GL_MODE"
  if [ -n "$UNITY_VERSIONS" ]; then
    case " $UNITY_VERSIONS " in *" $UNITY "*) ;; *)
      echo "note: this port was made for Unity $UNITY_VERSIONS; your copy is Unity $UNITY (another version of the game?)";;
    esac
  fi
  mark game
fi
. "$W/game.env"

# ---- 2. GLES mode: the game's shaders in GLSL ES 3.00 next to its OpenGL Core ones
if [ "$GL_MODE" = gles ] && [ ! -f "$W/.step_convert" ]; then
  hook pre_convert
  room 300 || fail "Converting the game's shaders needs about 300 MB free on the card ($(free_mb) MB free)."
  step "adding OpenGL ES shaders (if this is interrupted, the next launch continues where it stopped)"
  pm convert "$GD/$GAME_DIR/$DATA" --config "$S/gles.json" \
    || { [ $? = 2 ] && [ -f "$S/pmu" ] && fail "The setup's tools cannot convert this game's files yet (see patchlog.txt): the port needs the setup's Python."
         fail "Converting the game's shaders failed (see patchlog.txt). Launch again to continue."; }
  hook post_convert
  mark convert
fi

# ---- 3. for the launcher
cp "$W/game.env" "$GAMEDIR/game.env" || nowrite "the game's settings"
chmod +x "$GD/$GAME_DIR/$EXE"
hook post_install
# the game is marked set up, on the card, before the tools, the work folder and the donors go: a
# power cut in between leaves a game that starts (the launcher removes what is left), never one
# without the tools to finish it
sync
touch "$GAMEDIR/$READY" || nowrite "the setup's last mark"
sync
rm -rf "$W" "$S" "$GAMEDIR/donor"         # (donor/: donors a port names for its own setup steps)
# archives and installers the setup unpacked (the game's, Unity's player installer) are not needed
# any more: removed, as PortMaster ports' setups do, unless setup.txt says keep_installers=1
keep=$(sed -n 's/^[[:space:]]*keep_installers[[:space:]]*=[[:space:]]*\([01]\).*/\1/p' "$GAMEDIR/setup.txt" 2>/dev/null | tail -1)
for a in "$GD"/*; do
  [ -f "$a" ] || continue
  case "$(lower "$a")" in
    *.zip|*.7z|*.rar|*.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.pkg|*/unitysetup-*.exe) ;;
    *.sh) head -c 65536 "$a" | grep -aqE 'Makeself|MojoSetup' || continue;;
    *) continue;;
  esac
  if [ "$keep" = 1 ]; then echo "kept $(basename "$a") (keep_installers=1)"; continue; fi
  echo "removing $(basename "$a"): not needed to play (keep_installers=1 in setup.txt keeps it)"
  rm -f "$a"
done
sync
step "setup finished."
