#!/bin/bash
# What a newer setup does that a game set up by an earlier release has not had yet, done on its
# installed files (made with `pmunity port new`, android route). The launcher runs this through
# PortMaster's patcher when the game is set up and setup/update is there: a release brings the
# setup folder again, and a setup removes it when it ends, so a game set up by this release never
# runs it. Now:
#   - the game's code patches (asmpatch as the setup runs it, when the setup has it): `pmu
#     apk-asmpatch` runs asmpatch on the installed APK's assemblies; the patches they have already
#     say "done", a newer release's go in (after the APK's end: nothing there is overwritten)
#   - the game's videos (convert's `video` step, when the port's setup/convert.json has it):
#     `pmu video` makes the VP8 clips of the installed APK and OBB smaller in place on handhelds
#     with 1 GB of RAM or less (nothing elsewhere, for a game without such clips, or where the
#     port's libpmhwdec decodes VP8 on the handheld's video engine)
# It can be interrupted: the next launch runs it again. Log: ports/<port>/patchlog.txt.
# PortMaster's patcher protocol: a line "PATCH_FAIL_MSG:<text>" says why it failed.
S="${GAMEDIR:?}/setup"
. "$S/setup.env"

exec > >(tee -a "$GAMEDIR/patchlog.txt") 2>&1
echo "=== $(date) $PORT_TITLE update ==="
fail() { echo "PATCH_FAIL_MSG:$1"; echo "Update failed: $1"; echo "Patching process failed!"; exit 1; }
step() { echo; echo "== $(date +%H:%M:%S) $*"; }
if [ "$DEVICE_ARCH" != aarch64 ] || [ ! -f "$S/pmu" ]; then
  echo "no setup tools for this system ($DEVICE_ARCH): nothing to update"
  rm -rf "$S"
  exit 0
fi
chmod +x "$S/pmu" 2>/dev/null
"$S/pmu" >/dev/null 2>&1; [ $? = 2 ] || fail "The setup's tools (setup/pmu) do not run on this system (see patchlog.txt)."
echo "RAM $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null) MB"

SA=${STREAMING_ASSETS:-obb}
if { [ "${ASMPATCH:-off}" != off ] || [ "$SA" != obb ] || [ "${DATA_PATH:-0}" = 1 ]; } && [ -f "$S/asmpatch" ] \
   && [ -f "$GAMEDIR/$APK_NAME.apk" ]; then
  step "the game's code patches"
  f=$(df -Pm "$GAMEDIR" | awk 'NR==2{print $4}')
  [ -z "$f" ] || [ "$f" -gt 300 ] || fail "Patching the game's code needs about 300 MB free on the card ($f MB free)."
  chmod +x "$S/asmpatch"
  a="'$S/asmpatch'"
  # (as the setup ran it: the streaming-assets and data-path patches android-data adds too)
  case "${ASMPATCH:-off}" in auto) ;; off) a="$a --only=";; auto,*) a="$a --with=${ASMPATCH#auto,}";; *) a="$a --only=$ASMPATCH";; esac
  case "$SA" in both) a="$a --with=streaming-assets";; loose) a="$a --with=streaming-assets-all";; esac
  [ "${DATA_PATH:-0}" = 1 ] && a="$a --with=data-path"
  "$S/pmu" apk-asmpatch "$GAMEDIR/$APK_NAME.apk" "$GAMEDIR/.asmpatch-update" "$a" \
    || fail "Could not patch the game's code (see patchlog.txt)."
fi

if [ -f "$S/convert.json" ] && grep -q '"video"' "$S/convert.json"; then
  step "the game's videos (a few minutes on a 1 GB handheld)"
  # (where the port's libpmhwdec decodes VP8 on this handheld's video engine they are left as they
  # are: the hardware plays them in time; pmhw-test says so in milliseconds)
  t="$GAMEDIR/pmhwdec/pmhw-test"; r=
  if [ -f "$t" ]; then chmod +x "$t" "$GAMEDIR/pmhwdec/pmhw-cedard" 2>/dev/null; r=$("$t" -q 2>/dev/null | sed -n 's/^VP8: //p'); fi
  case "$r" in
    ""|"no hardware"*) "$S/pmu" video "$GAMEDIR" --config "$S/convert.json" || fail "Could not update the game's videos (see patchlog.txt).";;
    *) echo "VP8 on this handheld's video engine ($r): the videos are left as they are";;
  esac
fi

# (bash keeps this script open: on a FUSE card, Knulli's, setup/ stays behind empty until it ends;
# the launcher looks for setup/update)
rm -rf "$S" 2>/dev/null
sync
echo "update done"
