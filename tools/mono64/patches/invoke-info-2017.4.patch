+/*
+ * mono_unity_runtime_invoke_info: (portmaster-unity, tools/mono64) what mono_jit_runtime_invoke calls
+ * METHOD with in the current domain once its first call has made it: the runtime-invoke wrapper
+ * (*INVOKE) and the method's compiled code (*COMPILED). FALSE before that first call, while the
+ * class's initialisation has not run (mono_jit_runtime_invoke runs it first), and for a method it calls
+ * another way (the dynamic call path, the interpreter, LLVM-only). With exc given, a call of an
+ * initialised class's method then does nothing but *exc = NULL and INVOKE (obj, params, exc, COMPILED):
+ * the bridge's cached invoke calls the same wrapper itself and leaves out the lookup.
+ */
+MONO_API gboolean
+mono_unity_runtime_invoke_info (MonoMethod *method, gpointer *invoke, gpointer *compiled)
+{
+	MonoDomain *domain = mono_domain_get ();
+	RuntimeInvokeInfo *info;
+
+#ifdef ENABLE_INTERPRETER
+	if (mono_use_interpreter)
+		return FALSE;
+#endif
+	if (mono_llvm_only || !domain)
+		return FALSE;
+	info = (RuntimeInvokeInfo *)mono_conc_hashtable_lookup (domain_jit_info (domain)->runtime_invoke_hash, method);
+	if (!info || info->dyn_call_info || !info->vtable || !info->vtable->initialized || !info->runtime_invoke)
+		return FALSE;
+	*invoke = info->runtime_invoke;
+	*compiled = info->compiled_method;
+	return TRUE;
+}
+
 typedef struct {
 	MonoVTable *vtable;
 	int slot;
