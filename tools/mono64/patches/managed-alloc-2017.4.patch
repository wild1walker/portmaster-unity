+#if defined(USE_COMPILER_TLS)
+/* For Mono's managed allocator (portmaster-unity, tools/mono64): the   */
+/* path GC_FAST_MALLOC_GRANS takes for GC_malloc, GC_malloc_atomic and  */
+/* GC_gcj_malloc above when the thread's free list holds an object,     */
+/* and nothing else.  An object off this thread's free list,            */
+/* initialised as they initialise it, or NULL wherever they would do    */
+/* anything else (a thread without free lists, incremental mode, a      */
+/* size beyond the tiny lists, a counter or an empty list): nothing is  */
+/* changed then, and the caller makes the same call it made without     */
+/* this, which finds the same state.                                    */
+GC_INLINE void *GC_tl_try_pop(void **tiny_fl, size_t bytes)
+{
+    size_t granules = ROUNDED_UP_GRANULES(bytes);
+    void **my_fl;
+    void *my_entry;
+    void *next;
+
+    if (EXPECT(granules >= GC_TINY_FREELISTS, FALSE))
+        return NULL;
+    my_fl = tiny_fl + granules;
+    my_entry = *my_fl;
+    if (EXPECT((GC_word)my_entry <= DIRECT_GRANULES + GC_TINY_FREELISTS + 1,
+               FALSE))
+        return NULL;
+    next = *(void **)(my_entry);
+    *my_fl = next;
+    return my_entry;
+}
+
+/* (hidden: called from Mono's boehm-gc.c in the same library, directly) */
+#define GC_TL_TRY_API __attribute__((__visibility__("hidden")))
+
+/* kind: PTRFREE or NORMAL.                                             */
+GC_TL_TRY_API void * GC_tl_try_malloc_kind(size_t bytes, int kind)
+{
+    void *tsd = GC_thread_key;
+    void *result;
 
+    if (EXPECT(0 == tsd || GC_incremental, FALSE))
+        return NULL;
+    if (kind == PTRFREE) {
+        result = GC_tl_try_pop(((GC_tlfs)tsd) -> ptrfree_freelists, bytes);
+    } else if (kind == NORMAL) {
+        result = GC_tl_try_pop(((GC_tlfs)tsd) -> normal_freelists, bytes);
+        /* (GC_malloc's init) */
+        if (result != NULL)
+            obj_link(result) = 0;
+    } else {
+        return NULL;
+    }
+    return result;
+}
+
+# ifdef GC_GCJ_SUPPORT
+GC_TL_TRY_API void * GC_tl_try_gcj_malloc(size_t bytes,
+                                    void * ptr_to_struct_containing_descr)
+{
+    void *tsd = GC_thread_key;
+    void *result;
+
+    if (EXPECT(0 == tsd || GC_incremental || !GC_gcj_malloc_initialized,
+               FALSE))
+        return NULL;
+    result = GC_tl_try_pop(((GC_tlfs)tsd) -> gcj_freelists, bytes);
+    if (result != NULL) {
+        /* the free list first, then the method pointer (GC_gcj_malloc) */
+        AO_compiler_barrier();
+        *(void **)result = ptr_to_struct_containing_descr;
+    }
+    return result;
+}
+# endif /* GC_GCJ_SUPPORT */
+#endif /* USE_COMPILER_TLS */
