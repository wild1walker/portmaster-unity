+/*
+ * A managed allocator for Boehm (portmaster-unity, tools/mono64/build-mono.sh MONO64_MANAGED_ALLOC):
+ * the JIT calls these MONO_WRAPPER_ALLOC wrappers where it would call ves_icall_object_new_specific
+ * (or mono_class_get_allocation_ftn's ves_icall_object_new_fast, the same allocation for these
+ * classes) or ves_icall_string_alloc. A wrapper first calls mono_gc_boehm_try_alloc_obj / _string
+ * directly (no icall wrapper, no LMF): they take an object off this thread's Boehm free list
+ * (GC_tl_try_malloc_kind / GC_tl_try_gcj_malloc, thread_local_alloc.c: the path of the collector's
+ * own inline allocator when the list holds one, nothing else) and initialise and count it as
+ * mono_gc_alloc_obj / _string do. Wherever the call it replaces would do anything more (a finalizer,
+ * remoting or COM, the allocation profiler, a size beyond the collector's tiny free lists, an empty
+ * free list, incremental mode, a thread the collector has no free lists for) they change nothing and
+ * return NULL, and the wrapper makes that call, unchanged. MONO_BOEHM_MANAGED_ALLOC=0 in the
+ * environment: the JIT calls as before.
+ */
+void *GC_tl_try_malloc_kind (size_t bytes, int kind);
+void *GC_tl_try_gcj_malloc (size_t bytes, void *ptr_to_struct_containing_descr);
+
+MonoObject *mono_gc_boehm_try_alloc_obj (MonoVTable *vtable);
+MonoString *mono_gc_boehm_try_alloc_string (MonoVTable *vtable, gint32 len);
+
+enum {
+	BOEHM_ATYPE_NORMAL,	/* (vtable) */
+	BOEHM_ATYPE_SMALL,	/* (vtable, size): the size the JIT knows (the wrapper reads the class's, as the call it replaces) */
+	BOEHM_ATYPE_STRING,	/* (vtable, length) */
+	BOEHM_ATYPE_NUM
+};
+
+/* (longer strings go to the call the wrapper replaces, with its overflow checks) */
+#define BOEHM_TRY_MAX_LENGTH 0xffff
+
+static int boehm_managed_alloc = -1;	/* -1: not read yet */
+static gboolean boehm_icalls_registered;
+static MonoMethod *boehm_alloc_cache [BOEHM_ATYPE_NUM];
+static MonoMethod *boehm_slow_alloc_cache [BOEHM_ATYPE_NUM];
+
+MonoObject *
+mono_gc_boehm_try_alloc_obj (MonoVTable *vtable)
+{
+	MonoClass *klass = vtable->klass;
+	MonoObject *obj;
+	size_t size;
+
+	if (G_UNLIKELY (mono_profiler_events & MONO_PROFILE_ALLOCATIONS))
+		return NULL;
+	/* what mono_object_new_specific_checked does besides mono_gc_alloc_obj */
+	if (G_UNLIKELY (mono_vtable_is_remote (vtable) || mono_class_is_com_object (klass) || klass->has_finalize))
+		return NULL;
+
+	size = klass->instance_size;
+	/* mono_gc_alloc_obj, off the free list */
+	if (!klass->has_references) {
+		obj = (MonoObject *)GC_tl_try_malloc_kind (size, PTRFREE);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->vtable = vtable;
+		obj->synchronisation = NULL;
+
+		memset ((char *) obj + sizeof (MonoObject), 0, size - sizeof (MonoObject));
+	} else if (vtable->gc_descr != GC_NO_DESCRIPTOR) {
+		obj = (MonoObject *)GC_tl_try_gcj_malloc (size, vtable);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+	} else {
+		obj = (MonoObject *)GC_tl_try_malloc_kind (size, NORMAL);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->vtable = vtable;
+	}
+
+	gc_stats.new_object_count++;
+
+	return obj;
+}
+
+MonoString *
+mono_gc_boehm_try_alloc_string (MonoVTable *vtable, gint32 len)
+{
+	MonoString *obj;
+	size_t size;
+
+	if (G_UNLIKELY (mono_profiler_events & MONO_PROFILE_ALLOCATIONS))
+		return NULL;
+	if (G_UNLIKELY (len < 0 || len > BOEHM_TRY_MAX_LENGTH))
+		return NULL;
+
+	/* mono_string_new_size_checked's size, then mono_gc_alloc_string off the free list */
+	size = (G_STRUCT_OFFSET (MonoString, chars) + (((size_t)len + 1) * 2));
+	obj = (MonoString *)GC_tl_try_malloc_kind (size, PTRFREE);
+	if (G_UNLIKELY (!obj))
+		return NULL;
+
+	obj->object.vtable = vtable;
+	obj->object.synchronisation = NULL;
+	obj->length = len;
+	obj->chars [len] = 0;
+
+	gc_stats.new_object_count++;
+
+	return obj;
+}
+
+static gboolean
+boehm_managed_alloc_on (void)
+{
+	if (boehm_managed_alloc < 0) {
+		char *ma = g_getenv ("MONO_BOEHM_MANAGED_ALLOC");
+		boehm_managed_alloc = !(ma && !strcmp (ma, "0"));
+		g_free (ma);
+	}
+	return boehm_managed_alloc;
+}
 
+static MonoMethod *
+boehm_create_allocator (int atype, gboolean slowpath)
+{
+	static const char * const names [BOEHM_ATYPE_NUM] = { "Alloc", "AllocSmall", "AllocString" };
+	static const char * const slow_names [BOEHM_ATYPE_NUM] = { "SlowAlloc", "SlowAllocSmall", "SlowAllocString" };
+	MonoMethodBuilder *mb;
+	MonoMethodSignature *csig;
+	MonoMethod *res;
+	WrapperInfo *info;
+	int num_params = atype == BOEHM_ATYPE_NORMAL ? 1 : 2;
+	int pos = 0;
+
+	csig = mono_metadata_signature_alloc (mono_defaults.corlib, num_params);
+	if (atype == BOEHM_ATYPE_STRING) {
+		csig->ret = &mono_defaults.string_class->byval_arg;
+		csig->params [0] = &mono_defaults.int_class->byval_arg;
+		csig->params [1] = &mono_defaults.int32_class->byval_arg;
+	} else {
+		csig->ret = &mono_defaults.object_class->byval_arg;
+		for (int i = 0; i < num_params; i++)
+			csig->params [i] = &mono_defaults.int_class->byval_arg;
+	}
+
+	mb = mono_mb_new (mono_defaults.object_class, slowpath ? slow_names [atype] : names [atype], MONO_WRAPPER_ALLOC);
+
+	if (!slowpath) {
+		/* obj = mono_gc_boehm_try_alloc_* (vtable [, length]); if (obj) return obj; */
+		mono_mb_emit_ldarg (mb, 0);
+		if (atype == BOEHM_ATYPE_STRING) {
+			mono_mb_emit_ldarg (mb, 1);
+			mono_mb_emit_icall (mb, mono_gc_boehm_try_alloc_string);
+		} else {
+			mono_mb_emit_icall (mb, mono_gc_boehm_try_alloc_obj);
+		}
+		mono_mb_emit_byte (mb, MONO_CEE_DUP);
+		pos = mono_mb_emit_short_branch (mb, MONO_CEE_BRTRUE_S);
+		mono_mb_emit_byte (mb, MONO_CEE_POP);
+	}
+
+	/* the call the JIT makes without a managed allocator */
+	if (atype == BOEHM_ATYPE_STRING) {
+		mono_mb_emit_ldarg (mb, 1);
+		mono_mb_emit_icall (mb, ves_icall_string_alloc);
+	} else {
+		mono_mb_emit_ldarg (mb, 0);
+		mono_mb_emit_icall (mb, ves_icall_object_new_specific);
+	}
+
+	if (!slowpath)
+		mono_mb_patch_short_branch (mb, pos);
+	mono_mb_emit_byte (mb, MONO_CEE_RET);
+
+	info = mono_wrapper_info_create (mb, WRAPPER_SUBTYPE_NONE);
+	info->d.alloc.gc_name = "boehm";
+	info->d.alloc.alloc_type = atype;
+
+	res = mono_mb_create (mb, csig, 8, info);
+	mono_mb_free (mb);
+
+	return res;
+}
