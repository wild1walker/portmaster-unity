+GC_TL_TRY_API void * GC_tl_try_malloc_kind(size_t bytes, int kind)
+{
+    void *tsd = GC_thread_key;
+    void *result;
 
+    if (EXPECT(0 == tsd || GC_incremental, FALSE)
+        || EXPECT(kind != PTRFREE && kind != NORMAL, FALSE))
+        return NULL;
+    result = GC_tl_try_pop(((GC_tlfs)tsd) -> _freelists[kind], bytes);
+    /* (GC_malloc_kind's init; GC_end_stubborn_change is GC_dirty, a no-op */
+    /* outside incremental mode)                                         */
+    if (result != NULL && kind != PTRFREE)
+        obj_link(result) = 0;
+    return result;
+}
