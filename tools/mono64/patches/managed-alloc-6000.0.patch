+#if defined(USE_COMPILER_TLS)
+/* For Mono's managed allocator (portmaster-unity, tools/mono64): the   */
+/* first branch of GC_FAST_MALLOC_GRANS as GC_malloc_kind and          */
+/* GC_gcj_malloc above take it, and nothing else.  An object off this  */
+/* thread's free list, initialised as they initialise it, or NULL      */
+/* wherever they would do anything else (a thread without free lists,  */
+/* incremental mode, a size beyond the tiny lists, a counter or an     */
+/* empty list): nothing is changed then, and the caller makes the same */
+/* call it made without this, which finds the same state.             */
+GC_INLINE void *GC_tl_try_pop(void **tiny_fl, size_t bytes)
+{
+    size_t granules = ROUNDED_UP_GRANULES(bytes);
+    void **my_fl;
+    void *my_entry;
+    void *next;
+
+    if (EXPECT(granules >= GC_TINY_FREELISTS, FALSE))
+        return NULL;
+    my_fl = tiny_fl + granules;
+    my_entry = *my_fl;
+    if (EXPECT((GC_word)my_entry <= DIRECT_GRANULES + GC_TINY_FREELISTS + 1,
+               FALSE))
+        return NULL;
+    next = *(void **)(my_entry);
+    GC_FAST_M_AO_STORE(my_fl, next);
+    GC_PREFETCH_FOR_WRITE(next);
+    return my_entry;
+}
