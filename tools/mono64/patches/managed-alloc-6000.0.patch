+/*
+ * A managed allocator for Boehm (portmaster-unity, tools/mono64/build-mono.sh MONO64_MANAGED_ALLOC):
+ * the JIT calls these MONO_WRAPPER_ALLOC wrappers where it would call ves_icall_object_new_specific,
+ * ves_icall_array_new_specific or ves_icall_string_alloc. A wrapper first calls one of the
+ * mono_gc_boehm_try_alloc_* functions below directly (no icall wrapper, no LMF): they take an object
+ * off this thread's Boehm free list (GC_tl_try_malloc_kind / GC_tl_try_gcj_malloc, thread_local_alloc.c:
+ * the first branch of the collector's own inline allocator, nothing else) and initialise it as
+ * mono_gc_alloc_obj / _vector / _string do. Wherever the call it replaces would do anything more
+ * (a finalizer, weak fields, remoting or COM, the allocation profiler, heap validation, a size beyond
+ * the collector's tiny free lists, an empty free list, incremental mode, a thread the collector has
+ * no free lists for, Unity's gcj vectors) they change nothing and return NULL, and the wrapper makes
+ * that call, unchanged. MONO_BOEHM_MANAGED_ALLOC=0 in the environment: the JIT calls as before.
+ */
+void *GC_tl_try_malloc_kind (size_t bytes, int kind);
+void *GC_tl_try_gcj_malloc (size_t bytes, void *ptr_to_struct_containing_descr);
+
+MonoObject *mono_gc_boehm_try_alloc_obj (MonoVTable *vtable);
+MonoArray *mono_gc_boehm_try_alloc_vector (MonoVTable *vtable, uintptr_t n);
+MonoString *mono_gc_boehm_try_alloc_string (MonoVTable *vtable, gint32 len);
+
+enum {
+	BOEHM_ATYPE_NORMAL,	/* (vtable) */
+	BOEHM_ATYPE_SMALL,	/* (vtable, size): the size the JIT knows (the wrapper reads the class's, as the call it replaces) */
+	BOEHM_ATYPE_VECTOR,	/* (vtable, length) */
+	BOEHM_ATYPE_STRING,	/* (vtable, length) */
+	BOEHM_ATYPE_NUM
+};
+
+/* (longer lengths go to the calls the wrappers replace, with their overflow checks) */
+#define BOEHM_TRY_MAX_LENGTH 0xffff
+
+static MonoMethod *boehm_alloc_cache [BOEHM_ATYPE_NUM];
+static MonoMethod *boehm_slow_alloc_cache [BOEHM_ATYPE_NUM];
+
+MonoObject *
+mono_gc_boehm_try_alloc_obj (MonoVTable *vtable)
+{
+	MonoClass *klass = vtable->klass;
+	MonoObject *obj;
+	size_t size;
+
+	if (G_UNLIKELY (mono_profiler_allocations_enabled ()))
+		return NULL;
+#ifdef HEAP_VALIDATION_FREQUENCY
+	if (unity_heap_validation_callback && validate_frequency > 0)
+		return NULL;
+#endif
+	/* what mono_object_new_specific_checked does besides mono_gc_alloc_obj */
+	if (G_UNLIKELY (mono_vtable_is_remote (vtable) || mono_class_is_com_object (klass) ||
+			m_class_has_finalize (klass) || m_class_has_weak_fields (klass)))
+		return NULL;
+
+	size = m_class_get_instance_size (klass);
+	/* mono_gc_alloc_obj, off the free list */
+	if (!m_class_has_references (klass)) {
+		obj = (MonoObject *)GC_tl_try_malloc_kind (size, PTRFREE);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->vtable = vtable;
+		obj->synchronisation = NULL;
 
+		memset (mono_object_get_data (obj), 0, size - MONO_ABI_SIZEOF (MonoObject));
+	} else if (vtable->gc_descr != GC_NO_DESCRIPTOR) {
+		obj = (MonoObject *)GC_tl_try_gcj_malloc (size, vtable);
+	} else {
+		obj = (MonoObject *)GC_tl_try_malloc_kind (size, NORMAL);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->vtable = vtable;
+	}
+
+	return obj;
+}
+
+MonoArray *
+mono_gc_boehm_try_alloc_vector (MonoVTable *vtable, uintptr_t n)
+{
+	MonoClass *klass = vtable->klass;
+	MonoArray *obj;
+	size_t size;
+
+	if (G_UNLIKELY (mono_profiler_allocations_enabled ()))
+		return NULL;
+	if (G_UNLIKELY (n > BOEHM_TRY_MAX_LENGTH))
+		return NULL;
+
+	/* mono_array_calc_byte_len (no overflow at these lengths) */
+	size = (size_t)mono_array_element_size (klass) * n + MONO_SIZEOF_MONO_ARRAY;
+
+	/* mono_gc_alloc_vector, off the free list */
+	if (!m_class_has_references (klass)) {
+		obj = (MonoArray *)GC_tl_try_malloc_kind (size, PTRFREE);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->obj.vtable = vtable;
+		obj->obj.synchronisation = NULL;
+
+		memset (mono_object_get_data ((MonoObject*)obj), 0, size - MONO_ABI_SIZEOF (MonoObject));
+	} else if (klass->element_class->valuetype &&
+		klass->element_class->gc_descr != GC_NO_DESCRIPTOR &&
+		vtable->domain == mono_get_root_domain ()) {
+		/* GC_gcj_vector_malloc: left to mono_gc_alloc_vector */
+		return NULL;
+	} else {
+		obj = (MonoArray *)GC_tl_try_malloc_kind (size, NORMAL);
+		if (G_UNLIKELY (!obj))
+			return NULL;
+
+		obj->obj.vtable = vtable;
+	}
+
+	obj->max_length = n;
+
+	return obj;
+}
+
+MonoString *
+mono_gc_boehm_try_alloc_string (MonoVTable *vtable, gint32 len)
+{
+	MonoString *obj;
+	size_t size;
+
+	if (G_UNLIKELY (mono_profiler_allocations_enabled ()))
+		return NULL;
+	if (G_UNLIKELY (len < 0 || len > BOEHM_TRY_MAX_LENGTH))
+		return NULL;
+
+	/* mono_string_new_size_handle's size, then mono_gc_alloc_string off the free list */
+	size = (G_STRUCT_OFFSET (MonoString, chars) + (((size_t)len + 1) * 2));
+	obj = (MonoString *)GC_tl_try_malloc_kind (size, PTRFREE);
+	if (G_UNLIKELY (!obj))
+		return NULL;
+
+	obj->object.vtable = vtable;
+	obj->object.synchronisation = NULL;
+	obj->length = len;
+	obj->chars [len] = 0;
+
+	return obj;
+}
+
+static MonoMethod *
+boehm_create_allocator (int atype, gboolean slowpath)
+{
+	static const char * const names [BOEHM_ATYPE_NUM] = { "Alloc", "AllocSmall", "AllocVector", "AllocString" };
+	static const char * const slow_names [BOEHM_ATYPE_NUM] = { "SlowAlloc", "SlowAllocSmall", "SlowAllocVector", "SlowAllocString" };
+	MonoMethodBuilder *mb;
+	MonoMethodSignature *csig;
+	MonoMethod *res;
+	WrapperInfo *info;
+	int num_params = atype == BOEHM_ATYPE_NORMAL ? 1 : 2;
+	int pos = 0;
+
+	/* the functions the wrappers call first: plain calls (they never throw nor call managed code) */
+	mono_register_jit_icall_info (&mono_get_jit_icall_info ()->mono_gc_boehm_try_alloc_obj, mono_gc_boehm_try_alloc_obj,
+		"mono_gc_boehm_try_alloc_obj", mono_icall_sig_object_ptr, TRUE, "mono_gc_boehm_try_alloc_obj");
+	mono_register_jit_icall_info (&mono_get_jit_icall_info ()->mono_gc_boehm_try_alloc_vector, mono_gc_boehm_try_alloc_vector,
+		"mono_gc_boehm_try_alloc_vector", mono_icall_sig_object_ptr_ptr, TRUE, "mono_gc_boehm_try_alloc_vector");
+	mono_register_jit_icall_info (&mono_get_jit_icall_info ()->mono_gc_boehm_try_alloc_string, mono_gc_boehm_try_alloc_string,
+		"mono_gc_boehm_try_alloc_string", mono_icall_sig_object_ptr_int32, TRUE, "mono_gc_boehm_try_alloc_string");
+
+	csig = mono_metadata_signature_alloc (mono_defaults.corlib, num_params);
+	if (atype == BOEHM_ATYPE_STRING) {
+		csig->ret = m_class_get_byval_arg (mono_defaults.string_class);
+		csig->params [0] = mono_get_int_type ();
+		csig->params [1] = mono_get_int32_type ();
+	} else {
+		csig->ret = mono_get_object_type ();
+		for (int i = 0; i < num_params; i++)
+			csig->params [i] = mono_get_int_type ();
+	}
+
+	mb = mono_mb_new (mono_defaults.object_class, slowpath ? slow_names [atype] : names [atype], MONO_WRAPPER_ALLOC);
+
+	if (!slowpath) {
+		/* obj = mono_gc_boehm_try_alloc_* (vtable [, length]); if (obj) return obj; */
+		mono_mb_emit_ldarg (mb, 0);
+		if (atype == BOEHM_ATYPE_VECTOR) {
+			mono_mb_emit_ldarg (mb, 1);
+			mono_mb_emit_icall (mb, mono_gc_boehm_try_alloc_vector);
+		} else if (atype == BOEHM_ATYPE_STRING) {
+			mono_mb_emit_ldarg (mb, 1);
+			mono_mb_emit_icall (mb, mono_gc_boehm_try_alloc_string);
+		} else {
+			mono_mb_emit_icall (mb, mono_gc_boehm_try_alloc_obj);
+		}
+		mono_mb_emit_byte (mb, MONO_CEE_DUP);
+		pos = mono_mb_emit_short_branch (mb, MONO_CEE_BRTRUE_S);
+		mono_mb_emit_byte (mb, MONO_CEE_POP);
+	}
+
+	/* the call the JIT makes without a managed allocator */
+	switch (atype) {
+	case BOEHM_ATYPE_NORMAL:
+	case BOEHM_ATYPE_SMALL:
+		mono_mb_emit_ldarg (mb, 0);
+		mono_mb_emit_icall (mb, ves_icall_object_new_specific);
+		break;
+	case BOEHM_ATYPE_VECTOR:
+		mono_mb_emit_ldarg (mb, 0);
+		mono_mb_emit_ldarg (mb, 1);
+		mono_mb_emit_icall (mb, ves_icall_array_new_specific);
+		break;
+	case BOEHM_ATYPE_STRING:
+		mono_mb_emit_ldarg (mb, 1);
+		mono_mb_emit_icall (mb, ves_icall_string_alloc);
+		break;
+	default:
+		g_assert_not_reached ();
+	}
+
+	if (!slowpath)
+		mono_mb_patch_short_branch (mb, pos);
+	mono_mb_emit_byte (mb, MONO_CEE_RET);
+
+	info = mono_wrapper_info_create (mb, WRAPPER_SUBTYPE_NONE);
+	info->d.alloc.gc_name = "boehm";
+	info->d.alloc.alloc_type = atype;
+
+	res = mono_mb_create (mb, csig, 8, info);
+	mono_mb_free (mb);
+
+	return res;
+}
