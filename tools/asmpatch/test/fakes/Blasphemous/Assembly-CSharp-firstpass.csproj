<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for the blasphemous-i2-sources tests (no game or Unity code): I2.cs. Built by ../../../build.sh test into out/test/fakes/bl/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Assembly-CSharp-firstpass</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="I2.cs" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MSBuildThisFileDirectory)../../../out/test/fakes/bl/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
