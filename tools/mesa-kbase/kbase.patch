+static void
+jm_kbase_done(void *data, bool ok)
+{
+   (void)data;
+   if (!ok)
+      mesa_loge("panfrost: a kbase job faulted");
+}
+
+/* kbase (no DRM node, no syncobjs, no PANFROST_SUBMIT): the vertex/tiler chain and the fragment
+ * chain go to the kernel as two atoms in one JOB_SUBMIT, the fragment one depending on the other, and
+ * nothing waits: every BO the batch touches remembers the submission (pan_kmod_kbase_bo_set_seq), and
+ * BO waits and fences wait for it. The kmod runs submissions in order, which is also what keeps the
+ * shared tiler heap to one batch at a time. (JimVulkan/mesa-unified-drivers, jm_submit_batch_kbase.) */
+static int
+jm_submit_batch_kbase(struct panfrost_batch *batch, bool has_draws, bool has_frag)
+{
+   struct panfrost_context *ctx = batch->ctx;
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+
+   if (ctx->in_sync_fd >= 0) {
+      sync_wait(ctx->in_sync_fd, -1);
+      close(ctx->in_sync_fd);
+      ctx->in_sync_fd = -1;
+   }
+
+   const uint32_t permon = batch->need_job_req_cycle_count ? KBASE_JD_REQ_PERMON : 0;
+   struct pan_kmod_kbase_atom atoms[2];
+   unsigned n = 0;
+   if (has_draws) {
+      atoms[n] = (struct pan_kmod_kbase_atom){
+         .jc = batch->jm.jobs.vtc_jc.first_job,
+         .core_req = KBASE_JD_REQ_VERTEX_TILER | permon,
+         .atom_number = n + 1,
+      };
+      n++;
+   }
+   if (has_frag) {
+      atoms[n] = (struct pan_kmod_kbase_atom){
+         .jc = batch->jm.jobs.frag,
+         .core_req = KBASE_JD_REQ_FRAGMENT | permon,
+         .atom_number = n + 1,
+         .dep_atom = has_draws ? 1 : 0,
+      };
+      n++;
+   }
+   if (!n || ctx->is_noop)
+      return 0;
+
+   const uint64_t seq =
+      pan_kmod_kbase_submit_async(dev->kmod.dev, atoms, n, NULL, jm_kbase_done, NULL);
+   if (!seq) {
+      mesa_loge("panfrost: the kernel refused a kbase submission");
+      return -1;
+   }
+   ctx->kbase_seq = seq;
+
+   pan_bo_access *flags = util_dynarray_begin(&batch->bos);
+   unsigned end_bo = util_dynarray_num_elements(&batch->bos, pan_bo_access);
+   for (unsigned i = 0; i < end_bo; ++i) {
+      if (!flags[i])
+         continue;
+      struct panfrost_bo *bo = pan_lookup_bo(dev, i);
+      panfrost_context_report_bo_access(ctx, bo, flags[i]);
+      pan_kmod_kbase_bo_set_seq(bo->kmod_bo, seq);
+   }
+   util_dynarray_foreach(&batch->pool.bos, struct panfrost_bo *, bo)
+      pan_kmod_kbase_bo_set_seq((*bo)->kmod_bo, seq);
+   util_dynarray_foreach(&batch->invisible_pool.bos, struct panfrost_bo *, bo)
+      pan_kmod_kbase_bo_set_seq((*bo)->kmod_bo, seq);
+   if (has_draws && batch->jm.jobs.vtc_jc.first_tiler)
+      pan_kmod_kbase_bo_set_seq(dev->tiler_heap->kmod_bo, seq);
+   if (dev->sample_positions)
+      pan_kmod_kbase_bo_set_seq(dev->sample_positions->kmod_bo, seq);
+
+   if (dev->debug & (PAN_DBG_TRACE | PAN_DBG_SYNC)) {
+      pan_kmod_kbase_wait_seq(dev->kmod.dev, seq);
+      if (dev->debug & PAN_DBG_TRACE) {
+         for (unsigned i = 0; i < n; i++)
+            pandecode_jc(dev->decode_ctx, atoms[i].jc, panfrost_device_gpu_id(dev));
+      }
+      if (dev->debug & PAN_DBG_DUMP)
+         pandecode_dump_mappings(dev->decode_ctx);
+   }
+   return 0;
+}
