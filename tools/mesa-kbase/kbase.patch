+/*
+ * Copyright 2026 XclipseTools (JimVulkan/mesa-unified-drivers, a5010bb): the backend's design, the
+ *                event thread, the in-order atom chain and the process-local sync objects
+ * Copyright 2026 ARMSX2 and bmdhacks (bmdhacks/malisx2 src/kbase, with Knifethrower's UK 11.7 and 11.17
+ *                support, PR #60): every ioctl and struct this backend uses, through mali_kbase_*
+ * SPDX-License-Identifier: MIT
+ *
+ * kbase_kmod.c -- a pan_kmod backend for Arm's kbase kernel driver (/dev/mali0), job-manager GPUs.
+ *
+ * pan_kmod's own backends talk to a DRM render node (panfrost, panthor). Handhelds that ship Arm's
+ * kbase have no DRM node for the GPU at all. This backend drives kbase through the kbase layer of
+ * malisx2 (src/panfrost/lib/kmod/kbase/: context setup, GPU properties, memory, JOB_SUBMIT and the
+ * event channel), which negotiates the UK version the kernel speaks (job manager 11.7 to 11.36) and
+ * picks the struct layouts that version needs (the 48-byte base_jd_atom_v2 below 11.19, no executable
+ * zone before 11.13, the 16-byte MEM_JIT_INIT below 11.20, ...), each one pinned by a static assert.
+ * Nothing in this file builds an ioctl itself.
+ *
+ * The shape is JimVulkan's kbase_kmod.c (Mesa 26.3, Mali-G76/G72 phones), ported to this tree's
+ * pan_kmod API (bo_import by dma-buf fd, bo_mmap by the backend, a sync provider per device):
+ *   - kbase assigns every GPU VA at allocation, one address space a context: one VM, AUTO_VA only;
+ *   - SAME_VA memory: the mapping made at allocation fixes the address and owns the region (munmap
+ *     of it is the free); bo_mmap gives callers a second mapping of it, which they may unmap;
+ *   - shader code: the executable zone, a single CPU mapping, handed to the first bo_mmap;
+ *   - submission: atoms in one JOB_SUBMIT, each submission ORDER-dependent on the last atom of the
+ *     one before (the kernel runs them in order, which also keeps the tiler heap to one batch at a
+ *     time); one event thread reads completions; callers wait for a submission's sequence number;
+ *   - sync objects: binary objects in this process (kbase has none); sync files only where the
+ *     kernel has them (CONFIG_SYNC_FILE: the RK3326's kernels have not), else waits go through
+ *     the sequence numbers.
+ *   - AFBC is reported absent: the H700's Mali-G31 was built without it (Knifethrower's
+ *     h700-mali-wayland), and no AFBC is ever asked for on a kbase device.
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "drm-uapi/drm.h"
+#include "util/macros.h"
+#include "util/u_debug.h"
+#include "util/u_sync_provider.h"
+#include "util/timespec.h"
+
+#include "pan_kmod_backend.h"
+#include "kbase_kmod.h"
+#include "kbase/kbase.h"
+#include "kbase/uapi.h"
+#include "kbase/uapi_jm.h"
+
+extern const struct pan_kmod_ops kbase_kmod_ops;
+
+struct kbase_sub;
+
+/* Submission state of a device (see "submission" below). */
+struct kbase_queue {
+   pthread_mutex_t lock;
+   pthread_cond_t cond;              /* atom numbers freed, submissions completed */
+   struct kbase_sub *owner[256];     /* by atom number, NULL when free */
+   bool is_fence[256];
+   unsigned free_atoms;              /* of the numbers 1..255 */
+   uint8_t last_atom;                /* the newest GPU atom in flight, 0 if none */
+   uint64_t next_seq;
+   uint64_t open_seq[256];           /* submissions whose callback has not run yet */
+   unsigned nr_open_seq;
+   unsigned in_flight;               /* submissions and lone fence atoms */
+   pthread_t thread;
+   bool thread_started, stop;
+   /* sync files: unknown (0), work (1), the kernel has none (-1) */
+   int fences;
+};
+
+struct kbase_kmod_dev {
+   struct pan_kmod_dev base;
+   struct mali_kbase *kb;
+   int kb_fd;                        /* the fd kb was created on (a dup of base.fd) */
+   struct kbase_kmod_vm *vm;
+   uint32_t next_handle;
+   struct kbase_queue queue;
+};
+
+struct kbase_kmod_bo {
+   struct pan_kmod_bo base;
+   struct mali_kbase_bo kbo;
+   int dmabuf_fd;                    /* imports: our dup of the dma-buf, for CPU mappings; else -1 */
+   bool exec_map_given;              /* an executable BO's one mapping went to a bo_mmap caller */
+   uint64_t seq;                     /* the last submission that used it (pan_kmod_kbase_bo_set_seq) */
+};
+
+struct kbase_kmod_vm {
+   struct pan_kmod_vm base;
+};
+
+static struct kbase_kmod_dev *
+to_kdev(const struct pan_kmod_dev *dev)
+{
+   return container_of(dev, struct kbase_kmod_dev, base);
+}
+
+static void kbase_queue_init(struct kbase_queue *q);
+static void kbase_queue_finish(struct kbase_kmod_dev *kdev);
+
+bool
+pan_kmod_dev_is_kbase(const struct pan_kmod_dev *dev)
+{
+   return dev && dev->ops == &kbase_kmod_ops;
+}
+
+/* ---- the kbase layer's OS backend: the context is made on our fd --------------------------
+ *
+ * mali_kbase_create opens the device itself; Mesa has already opened it (the EGL platform or the
+ * loader), so open() hands back a dup of that fd. kbase's context is per open file description,
+ * so the dup is the same context Mesa's fd refers to. */
+
+struct fd_backend {
+   struct mali_kbase_backend b;
+   int fd;
+};
+
+static int
+fdb_open(void *priv, const char *path)
+{
+   (void)path;
+   const int fd = fcntl(((struct fd_backend *)priv)->fd, F_DUPFD_CLOEXEC, 3);
+   return fd;
+}
+
+static void
+kbase_log(void *user, const char *msg)
+{
+   (void)user;
+   mesa_logi("kbase: %s", msg);
+}
+
+/* Is fd Arm's kbase node? (A DRM driver answers DRM_IOCTL_VERSION; kbase does not reliably, and
+ * on some kernels returns success for DRM ioctls it does not implement, so the device path decides.) */
+static bool
+fd_is_kbase(int fd)
+{
+   char link[64], path[256];
+   snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+   const ssize_t n = readlink(link, path, sizeof(path) - 1);
+   if (n <= 0)
+      return false;
+   path[n] = 0;
+   return !strncmp(path, "/dev/mali", 9);
+}
+
+static void
+kbase_props(const struct mali_kbase *kb, struct pan_kmod_dev_props *props)
+{
+   const struct mali_kbase_gpu_props *p = &kb->props;
+
+   memset(props, 0, sizeof(*props));
+   /* GPU_ID: product id in 31:16, revision in 15:0 (major 15:12, minor 11:4, status 3:0), as
+    * DRM panfrost reports it. */
+   props->gpu_id = ((uint64_t)p->product_id << 16) | ((p->major_revision & 0xf) << 12) |
+                   ((p->minor_revision & 0xff) << 4) | (p->version_status & 0xf);
+   props->shader_present = p->shader_present;
+   props->tiler_features = p->tiler_features;
+   props->mem_features = p->mem_features;
+   props->mmu_features = p->mmu_features;
+   props->l2_features = p->l2_features;
+   props->gpu_features = p->gpu_features;
+   for (unsigned i = 0; i < 4; i++)
+      props->texture_features[i] = p->raw_texture_features[i] ? p->raw_texture_features[i]
+                                                              : p->texture_features[i];
+   /* Nonzero: no AFBC (pan_query_afbc). Never on kbase: the H700's G31 has none. */
+   props->afbc_features = 1;
+
+   props->max_threads_per_core = p->thread_max_threads ? p->thread_max_threads : p->max_threads;
+   props->max_threads_per_wg =
+      p->thread_max_workgroup_size ? p->thread_max_workgroup_size : p->max_workgroup_size;
+   props->max_tasks_per_core = (p->thread_features >> 24) & 0xff;
+   if (!props->max_tasks_per_core)
+      props->max_tasks_per_core = 1;
+   props->num_registers_per_core = p->max_registers ? p->max_registers
+                                                    : props->max_threads_per_core * 32;
+   props->max_tls_instance_per_core = p->thread_tls_alloc ? p->thread_tls_alloc
+                                                          : props->max_threads_per_core;
+   if (!props->max_tls_instance_per_core)
+      props->max_tls_instance_per_core = props->max_threads_per_core;
+
+   /* PERMON on an atom starts the cycle counter, which is what makes timestamps propagate. */
+   props->gpu_can_query_timestamp = true;
+   props->timestamp_device_coherent = true;
+#if defined(__aarch64__)
+   uint64_t f;
+   __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+   props->timestamp_frequency = f;
+#endif
+   if (props->timestamp_frequency)
+      props->timestamp_cycles_to_ns_factor = (double)NSEC_PER_SEC / props->timestamp_frequency;
+
+   props->allowed_group_priorities_mask = PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM;
+   props->supported_bo_flags =
+      PAN_KMOD_BO_FLAG_EXECUTABLE | PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT | PAN_KMOD_BO_FLAG_NO_MMAP |
+      PAN_KMOD_BO_FLAG_WB_MMAP;
+   props->is_io_coherent = false;
+   props->pgsize_bitmap = PAN_PGSIZE_4K;
+}
+
+/* ---- device ------------------------------------------------------------------------------- */
+
+static struct pan_kmod_dev *
+kbase_kmod_dev_create(int fd, uint32_t flags, const struct pan_kmod_allocator *allocator)
+{
+   if (!fd_is_kbase(fd))
+      return NULL;
+
+   struct kbase_kmod_dev *kdev = pan_kmod_alloc(allocator, sizeof(*kdev));
+   if (!kdev)
+      return NULL;
+   memset(kdev, 0, sizeof(*kdev));
+
+   static struct fd_backend fdb; /* (one device a process is all Mesa makes here) */
+   fdb.b = *mali_kbase_os_backend();
+   fdb.b.priv = &fdb;
+   fdb.b.open = fdb_open;
+   fdb.fd = fd;
+
+   const struct mali_kbase_create_info ci = {
+      .device_path = "/dev/mali0",
+      .backend = &fdb.b,
+      .log = kbase_log,
+   };
+   enum mali_kbase_result r = mali_kbase_create(&ci, &kdev->kb);
+   if (r != MALI_KBASE_SUCCESS) {
+      mesa_loge("kbase: no context on fd %d: %s", fd, mali_kbase_result_str(r));
+      pan_kmod_free(allocator, kdev);
+      return NULL;
+   }
+   if (kdev->kb->frontend != MALI_KBASE_FRONTEND_JM) {
+      mesa_loge("kbase: a command-stream (CSF) kernel: this backend drives job-manager GPUs only");
+      mali_kbase_destroy(kdev->kb);
+      pan_kmod_free(allocator, kdev);
+      return NULL;
+   }
+   kdev->kb_fd = kdev->kb->fd;
+
+   char layout[160];
+   mesa_logi("kbase: UK %u.%u, GPU 0x%04x r%up%u, %u cores; %s", kdev->kb->uk_major,
+             kdev->kb->uk_minor, kdev->kb->props.product_id, kdev->kb->props.major_revision,
+             kdev->kb->props.minor_revision, kdev->kb->props.core_count,
+             mali_kbase_jm_atom_layout_str(kdev->kb, layout, sizeof(layout)));
+
+   struct pan_kmod_driver drv = {.version = {.major = kdev->kb->uk_major,
+                                             .minor = kdev->kb->uk_minor}};
+   if (pan_kmod_dev_init(&kdev->base, fd, flags, &drv, allocator, &kbase_kmod_ops,
+                         pan_kmod_kbase_sync_provider())) {
+      mali_kbase_destroy(kdev->kb);
+      pan_kmod_free(allocator, kdev);
+      return NULL;
+   }
+   kbase_props(kdev->kb, &kdev->base.props);
+   kdev->next_handle = 1;
+   kbase_queue_init(&kdev->queue);
+   return &kdev->base;
+}
+
+static void
+kbase_kmod_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(dev);
+
+   kbase_queue_finish(kdev);
+   mali_kbase_destroy(kdev->kb);
+   pan_kmod_dev_cleanup(dev);
+   pan_kmod_free(dev->allocator, kdev);
+}
+
+static struct pan_kmod_va_range
+kbase_kmod_dev_query_user_va_range(const struct pan_kmod_dev *dev)
+{
+   /* kbase hands out the addresses; this only describes the space they live in. The low 4 GiB
+    * hold kbase's own special mappings (the tracking page at 3 << 12). */
+   const unsigned va_bits = MMU_FEATURES_VA_BITS(dev->props.mmu_features);
+   return (struct pan_kmod_va_range){
+      .start = 4ull << 30,
+      .size = (1ull << va_bits) - (4ull << 30),
+   };
+}
+
+/* ---- buffer objects ------------------------------------------------------------------------ */
+
+#define KBASE_GROW_INITIAL_PAGES 256ull
+#define KBASE_GROW_STEP_PAGES    512ull
+
+static struct pan_kmod_bo *
+kbase_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm, uint64_t size,
+                    uint32_t flags)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(dev);
+
+   if (flags & PAN_KMOD_BO_FLAG_GPU_UNCACHED)
+      return NULL;
+
+   struct kbase_kmod_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo)
+      return NULL;
+   memset(bo, 0, sizeof(*bo));
+   bo->dmabuf_fd = -1;
+
+   enum mali_kbase_result r;
+   if (flags & PAN_KMOD_BO_FLAG_EXECUTABLE) {
+      r = mali_kbase_alloc_program(kdev->kb, size, &bo->kbo);
+   } else {
+      const bool grow = flags & PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT;
+      const bool cached = flags & PAN_KMOD_BO_FLAG_WB_MMAP;
+      const uint64_t pages = DIV_ROUND_UP(size, 4096);
+      uint64_t kflags = cached ? MALI_KBASE_FLAGS_DEVICE_CACHED : MALI_KBASE_FLAGS_DEVICE_UNCACHED;
+      if (grow)
+         kflags |= KB_MEM_GROW_ON_GPF;
+      const struct mali_kbase_alloc_info ai = {
+         .size = size,
+         .commit_size = grow ? MIN2(pages, KBASE_GROW_INITIAL_PAGES) * 4096 : 0,
+         .extension_pages = grow ? KBASE_GROW_STEP_PAGES : 0,
+         .flags = mali_kbase_mem_same_va_policy(kflags) | kflags,
+         .mem_class = cached ? MALI_KBASE_MEM_CLASS_DEVICE_CPU_CACHED
+                             : MALI_KBASE_MEM_CLASS_DEVICE_CPU_UNCACHED,
+         .cpu_map = !(flags & PAN_KMOD_BO_FLAG_NO_MMAP),
+      };
+      r = mali_kbase_alloc(kdev->kb, &ai, &bo->kbo);
+   }
+   if (r != MALI_KBASE_SUCCESS) {
+      mesa_loge("kbase: allocation of %" PRIu64 " bytes (flags 0x%x) failed: %s", size, flags,
+                mali_kbase_result_str(r));
+      pan_kmod_dev_free(dev, bo);
+      return NULL;
+   }
+
+   pan_kmod_bo_init(&bo->base, dev, exclusive_vm, bo->kbo.size, flags, kdev->next_handle++);
+   return &bo->base;
+}
+
+static void
+kbase_kmod_bo_free(struct pan_kmod_bo *bo)
+{
+   struct kbase_kmod_bo *kbo = container_of(bo, struct kbase_kmod_bo, base);
+   struct kbase_kmod_dev *kdev = to_kdev(bo->dev);
+
+   /* kbase frees memory at once, not when the jobs using it are done: wait for the last
+    * submission that used it (everything so far when nobody said which). */
+   pan_kmod_kbase_wait_seq(bo->dev, kbo->seq ? kbo->seq : 0);
+
+   if (kbo->exec_map_given) {
+      /* The caller unmapped the one mapping already. */
+      kbo->kbo.attrs &= ~MALI_KBASE_BO_CPU_MAPPED;
+      kbo->kbo.cpu = NULL;
+   }
+   mali_kbase_free(kdev->kb, &kbo->kbo);
+   if (kbo->dmabuf_fd >= 0)
+      close(kbo->dmabuf_fd);
+   pan_kmod_dev_free(bo->dev, kbo);
+}
+
+static void *
+kbase_kmod_bo_mmap(struct pan_kmod_bo *bo, int prot, int flags, void *host_addr)
+{
+   struct kbase_kmod_bo *kbo = container_of(bo, struct kbase_kmod_bo, base);
+   struct kbase_kmod_dev *kdev = to_kdev(bo->dev);
+
+   if (kbo->dmabuf_fd >= 0) /* an import: CPU access through the dma-buf itself */
+      return mmap(host_addr, bo->size, prot, flags, kbo->dmabuf_fd, 0);
+
+   if (kbo->kbo.attrs & MALI_KBASE_BO_SAME_VA) {
+      /* A second mapping of the region (offset = its address); the first one owns it. */
+      return mmap(host_addr, bo->size, prot, flags, kdev->kb_fd, (off_t)kbo->kbo.gpu_va);
+   }
+
+   /* Executable memory allows one CPU mapping: hand it over, once. */
+   if (kbo->kbo.cpu && !kbo->exec_map_given && !host_addr) {
+      kbo->exec_map_given = true;
+      return kbo->kbo.cpu;
+   }
+   errno = ENOMEM;
+   return MAP_FAILED;
+}
+
+static struct pan_kmod_bo *
+kbase_kmod_bo_import(struct pan_kmod_dev *dev, int fd)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(dev);
+   struct kbase_kmod_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo)
+      return NULL;
+   memset(bo, 0, sizeof(*bo));
+
+   enum mali_kbase_result r =
+      mali_kbase_import_dmabuf(kdev->kb, fd, MALI_KBASE_FLAGS_IMPORT, 0, true, &bo->kbo);
+   if (r != MALI_KBASE_SUCCESS) {
+      mesa_loge("kbase: import of dma-buf %d failed: %s", fd, mali_kbase_result_str(r));
+      pan_kmod_dev_free(dev, bo);
+      return NULL;
+   }
+   bo->dmabuf_fd = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+   pan_kmod_bo_init(&bo->base, dev, NULL, bo->kbo.size, PAN_KMOD_BO_FLAG_IMPORTED,
+                    kdev->next_handle++);
+   return &bo->base;
+}
+
+static int
+kbase_kmod_bo_export(struct pan_kmod_bo *bo)
+{
+   /* kbase memory is not a dma-buf. Nothing here shares buffers with another process: the
+    * window is presented by copying (see docs/mesa.md in portmaster-unity). */
+   (void)bo;
+   errno = ENOTSUP;
+   return -1;
+}
+
+void
+pan_kmod_kbase_bo_set_seq(struct pan_kmod_bo *bo, uint64_t seq)
+{
+   if (bo && pan_kmod_dev_is_kbase(bo->dev))
+      container_of(bo, struct kbase_kmod_bo, base)->seq = seq;
+}
+
+static bool
+kbase_kmod_bo_wait(struct pan_kmod_bo *bo, int64_t timeout_ns, bool for_read_only_access)
+{
+   (void)for_read_only_access;
+   /* The last submission that used the BO (kbase has no per-BO wait). Readers and writers are
+    * not told apart: a submission is waited for whole. */
+   const uint64_t seq = container_of(bo, struct kbase_kmod_bo, base)->seq;
+   if (!seq)
+      return true;
+   struct timespec now;
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   const int64_t now_ns = (int64_t)now.tv_sec * 1000000000ll + now.tv_nsec;
+   const int64_t abs = timeout_ns >= INT64_MAX - now_ns ? INT64_MAX : now_ns + timeout_ns;
+   return pan_kmod_kbase_wait_seq_timeout(bo->dev, seq, abs);
+}
+
+static int
+kbase_kmod_flush_bo_map_syncs(struct pan_kmod_dev *dev)
+{
+   /* Cache maintenance of WB_MMAP mappings runs in userspace (pan_kmod_queue_bo_map_sync). */
+   (void)dev;
+   return 0;
+}
+
+/* ---- address space ------------------------------------------------------------------------- */
+
+static struct pan_kmod_vm *
+kbase_kmod_vm_create(struct pan_kmod_dev *dev, uint32_t flags, uint64_t va_start,
+                     uint64_t va_range)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(dev);
+   (void)va_start;
+   (void)va_range;
+
+   if (kdev->vm || !(flags & PAN_KMOD_VM_FLAG_AUTO_VA)) {
+      mesa_loge("kbase: one VM per device, AUTO_VA only: the kernel owns the addresses");
+      return NULL;
+   }
+   struct kbase_kmod_vm *vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm)
+      return NULL;
+   pan_kmod_vm_init(&vm->base, dev, 0, flags);
+   kdev->vm = vm;
+   return &vm->base;
+}
+
+static void
+kbase_kmod_vm_destroy(struct pan_kmod_vm *vm)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(vm->dev);
+   kdev->vm = NULL;
+   pan_kmod_vm_cleanup(vm);
+   pan_kmod_dev_free(vm->dev, container_of(vm, struct kbase_kmod_vm, base));
+}
+
+static int
+kbase_kmod_vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode,
+                   struct pan_kmod_vm_op *ops, uint32_t op_count)
+{
+   (void)vm;
+   if (mode != PAN_KMOD_VM_OP_MODE_IMMEDIATE && mode != PAN_KMOD_VM_OP_MODE_DEFER_TO_NEXT_IDLE_POINT)
+      return -1;
+   for (uint32_t i = 0; i < op_count; i++) {
+      if (ops[i].type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         if (ops[i].va.start != PAN_KMOD_VM_MAP_AUTO_VA)
+            return -1;
+         /* MEM_ALLOC made the mapping: report where the kernel put it. */
+         ops[i].va.start = container_of(ops[i].map.bo, struct kbase_kmod_bo, base)->kbo.gpu_va;
+      } else if (ops[i].type != PAN_KMOD_VM_OP_TYPE_UNMAP) {
+         return -1;
+      }
+   }
+   return 0;
+}
+
+static uint64_t
+kbase_kmod_query_timestamp(const struct pan_kmod_dev *dev)
+{
+   uint64_t mono, ts;
+   if (mali_kbase_timeinfo(to_kdev(dev)->kb, &mono, &ts) == MALI_KBASE_SUCCESS)
+      return ts;
+#if defined(__aarch64__)
+   uint64_t v;
+   __asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(v) : : "memory");
+   return v;
+#else
+   return 0;
+#endif
+}
+
+/* ---- sync objects (JimVulkan's, unchanged in substance) --------------------------------------
+ *
+ * kbase has no syncobjs. These are binary objects kept in this process with the DRM syncobj
+ * semantics Mesa's runtime expects: unsignaled, submitted (its signal operation queued: satisfies
+ * WAIT_AVAILABLE) or signaled; a sync file attached when the kernel gave one. */
+
+#include "kbase_kmod_sync.c.inc"
+
+/* ---- submission -------------------------------------------------------------------------------
+ *
+ * One thread per device reads the completion events; a submission returns once the kernel has its
+ * atoms. Atom numbers (1..255, unique among the atoms in flight) come from one allocator. Each
+ * submission's first atom ORDER-depends on the newest GPU atom still in flight, so submissions run
+ * in order (ORDER, so a fault does not spread). A completion callback runs on the event thread once
+ * every atom of the submission has reported, before pan_kmod_kbase_wait_seq sees it complete.
+ *
+ * A sync file for a submission comes from a FENCE_TRIGGER soft atom behind its last atom, where the
+ * kernel has sync files. Where it has not (JOB_SUBMIT refuses the soft atom, or it completes with an
+ * error), fences are turned off for the device and callers get -1: they wait on the sequence number. */
+
+#define KBASE_ATOM_TAG 0x50414e4b42ull /* "PANKB", comes back in the event's udata */
+
+struct kbase_sub {
+   uint64_t seq;
+   unsigned pending;
+   bool ok;
+   pan_kmod_kbase_done_cb done;
+   void *data;
+};
+
+static void *
+kbase_event_thread(void *arg)
+{
+   struct kbase_kmod_dev *kdev = arg;
+   struct kbase_queue *q = &kdev->queue;
+
+   for (;;) {
+      pthread_mutex_lock(&q->lock);
+      const bool stop = q->stop && !q->in_flight;
+      pthread_mutex_unlock(&q->lock);
+      if (stop)
+         break;
+
+      if (mali_kbase_jm_poll(kdev->kb, 100) <= 0)
+         continue;
+
+      struct kb_jm_event ev[16];
+      unsigned n = 0;
+      if (mali_kbase_jm_read_events(kdev->kb, ev, ARRAY_SIZE(ev), &n, NULL) != MALI_KBASE_SUCCESS ||
+          !n)
+         continue;
+
+      struct kbase_sub *finished[16];
+      unsigned nr_finished = 0;
+
+      pthread_mutex_lock(&q->lock);
+      for (unsigned i = 0; i < n; i++) {
+         if (ev[i].udata[0] != KBASE_ATOM_TAG)
+            continue;
+         const uint8_t an = ev[i].atom_number;
+         struct kbase_sub *sub = q->owner[an];
+         if (!sub) {
+            mesa_loge("kbase: event for atom %u, which is not in flight", an);
+            continue;
+         }
+         q->owner[an] = NULL;
+         q->free_atoms++;
+         if (q->last_atom == an)
+            q->last_atom = 0;
+         if (ev[i].event_code != KB_JM_EVENT_DONE) {
+            if (q->is_fence[an]) {
+               if (q->fences >= 0)
+                  mesa_logw("kbase: a fence-trigger atom ended with event 0x%x: no sync files on "
+                            "this kernel, fences wait on submissions",
+                            ev[i].event_code);
+               q->fences = -1;
+            } else {
+               mesa_loge("kbase: atom %u ended with event 0x%x, not DONE", an, ev[i].event_code);
+               sub->ok = false;
+            }
+         }
+         q->is_fence[an] = false;
+         if (--sub->pending == 0)
+            finished[nr_finished++] = sub;
+      }
+      pthread_cond_broadcast(&q->cond);
+      pthread_mutex_unlock(&q->lock);
+
+      for (unsigned i = 0; i < nr_finished; i++) {
+         struct kbase_sub *sub = finished[i];
+         if (sub->done)
+            sub->done(sub->data, sub->ok);
+         pthread_mutex_lock(&q->lock);
+         for (unsigned k = 0; sub->seq && k < q->nr_open_seq; k++) {
+            if (q->open_seq[k] == sub->seq) {
+               q->open_seq[k] = q->open_seq[--q->nr_open_seq];
+               break;
+            }
+         }
+         q->in_flight--;
+         pthread_cond_broadcast(&q->cond);
+         pthread_mutex_unlock(&q->lock);
+         free(sub);
+      }
+   }
+   return NULL;
+}
+
+static void
+kbase_queue_init(struct kbase_queue *q)
+{
+   pthread_mutex_init(&q->lock, NULL);
+   pthread_condattr_t attr;
+   pthread_condattr_init(&attr);
+   pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+   pthread_cond_init(&q->cond, &attr);
+   pthread_condattr_destroy(&attr);
+   q->free_atoms = 255;
+   q->next_seq = 1;
+   q->fences = debug_get_bool_option("PAN_KBASE_NO_FENCES", false) ? -1 : 0;
+}
+
+static void
+kbase_queue_finish(struct kbase_kmod_dev *kdev)
+{
+   struct kbase_queue *q = &kdev->queue;
+
+   pthread_mutex_lock(&q->lock);
+   q->stop = true;
+   const bool started = q->thread_started;
+   pthread_mutex_unlock(&q->lock);
+   if (started)
+      pthread_join(q->thread, NULL);
+   pthread_cond_destroy(&q->cond);
+   pthread_mutex_destroy(&q->lock);
+}
+
+/* The JOB_SUBMIT itself; atoms built by the caller. True when the kernel took them. */
+static bool
+kbase_job_submit(struct kbase_kmod_dev *kdev, const struct kb_jm_atom *jd, unsigned n)
+{
+   enum mali_kbase_result r = mali_kbase_jm_submit(kdev->kb, jd, n);
+   if (r != MALI_KBASE_SUCCESS) {
+      mesa_loge("kbase: JOB_SUBMIT of %u atoms failed: %s", n, mali_kbase_result_str(r));
+      return false;
+   }
+   return true;
+}
+
+uint64_t
+pan_kmod_kbase_submit_async(struct pan_kmod_dev *dev, const struct pan_kmod_kbase_atom *atoms,
+                            unsigned nr_atoms, int *fence_fd, pan_kmod_kbase_done_cb done,
+                            void *data)
+{
+   struct kbase_kmod_dev *kdev = to_kdev(dev);
+   struct kbase_queue *q = &kdev->queue;
+
+   if (fence_fd)
+      *fence_fd = -1;
+   if (nr_atoms > PAN_KMOD_KBASE_MAX_ATOMS)
+      return 0;
+
+   pthread_mutex_lock(&q->lock);
+
+   if (!q->thread_started) {
+      if (pthread_create(&q->thread, NULL, kbase_event_thread, kdev)) {
+         pthread_mutex_unlock(&q->lock);
+         mesa_loge("kbase: could not start the event thread");
+         return 0;
+      }
+      q->thread_started = true;
+   }
+
+   const uint64_t seq = q->next_seq++;
+   bool fence = fence_fd && q->fences >= 0 && (nr_atoms || q->last_atom);
+
+retry:;
+   const unsigned need = nr_atoms + fence;
+   if (!need) {
+      /* Nothing to run: complete once the earlier submissions have, so completion stays in order. */
+      while (q->nr_open_seq)
+         pthread_cond_wait(&q->cond, &q->lock);
+      pthread_mutex_unlock(&q->lock);
+      if (done)
+         done(data, true);
+      return seq;
+   }
+
+   while (q->free_atoms < need)
+      pthread_cond_wait(&q->cond, &q->lock);
+
+   const bool split = fence && nr_atoms;
+   struct kbase_sub *sub = calloc(1, sizeof(*sub));
+   struct kbase_sub *fsub = split ? calloc(1, sizeof(*fsub)) : NULL;
+   if (!sub || (split && !fsub)) {
+      free(sub);
+      free(fsub);
+      pthread_mutex_unlock(&q->lock);
+      return 0;
+   }
+   *sub = (struct kbase_sub){.seq = seq, .pending = split ? nr_atoms : need, .ok = true,
+                             .done = done, .data = data};
+   if (split)
+      *fsub = (struct kbase_sub){.pending = 1, .ok = true};
+
+   uint8_t real[PAN_KMOD_KBASE_MAX_ATOMS + 1];
+   uint8_t rel_to_real[256] = {0};
+   unsigned next = 1;
+   for (unsigned i = 0; i < need; i++) {
+      while (q->owner[next])
+         next++;
+      assert(next <= 255);
+      real[i] = next;
+      q->owner[next] = split && i == nr_atoms ? fsub : sub;
+      q->is_fence[next] = fence && i == nr_atoms;
+      next++;
+   }
+   for (unsigned i = 0; i < nr_atoms; i++)
+      rel_to_real[atoms[i].atom_number] = real[i];
+
+   struct kb_jm_atom jd[PAN_KMOD_KBASE_MAX_ATOMS + 1];
+   memset(jd, 0, need * sizeof(jd[0]));
+   for (unsigned i = 0; i < nr_atoms; i++) {
+      jd[i].jc = atoms[i].jc;
+      jd[i].core_req = atoms[i].core_req;
+      jd[i].atom_number = real[i];
+      jd[i].udata[0] = KBASE_ATOM_TAG;
+      jd[i].udata[1] = seq;
+      if (atoms[i].dep_atom) {
+         jd[i].pre_dep[0].atom_id = rel_to_real[atoms[i].dep_atom];
+         jd[i].pre_dep[0].dependency_type = KB_JM_DEP_DATA;
+      } else if (q->last_atom) {
+         jd[i].pre_dep[0].atom_id = q->last_atom;
+         jd[i].pre_dep[0].dependency_type = KB_JM_DEP_ORDER;
+      }
+   }
+
+   /* base_fence: the kernel reads it at submit time and writes the sync file's fd into it. */
+   struct {
+      int fd;
+      int stream_fd;
+   } base_fence = {-1, -1};
+   if (fence) {
+      struct kb_jm_atom *f = &jd[nr_atoms];
+      f->jc = (uintptr_t)&base_fence;
+      f->core_req = KB_JM_REQ_SOFT_FENCE_TRIGGER;
+      f->atom_number = real[nr_atoms];
+      f->udata[0] = KBASE_ATOM_TAG;
+      f->udata[1] = seq;
+      f->pre_dep[0].atom_id = nr_atoms ? real[nr_atoms - 1] : q->last_atom;
+      f->pre_dep[0].dependency_type = KB_JM_DEP_ORDER;
+   }
+
+   if (!kbase_job_submit(kdev, jd, need)) {
+      for (unsigned i = 0; i < need; i++) {
+         q->owner[real[i]] = NULL;
+         q->is_fence[real[i]] = false;
+      }
+      free(sub);
+      free(fsub);
+      if (fence) {
+         /* A kernel without sync files refuses the fence-trigger atom: no fences from now on,
+          * and this submission goes again without one. */
+         mesa_logw("kbase: JOB_SUBMIT refused a fence-trigger atom: no sync files on this kernel");
+         q->fences = -1;
+         fence = false;
+         goto retry;
+      }
+      pthread_mutex_unlock(&q->lock);
+      return 0;
+   }
+
+   q->free_atoms -= need;
+   if (nr_atoms)
+      q->last_atom = real[nr_atoms - 1];
+   q->in_flight += split ? 2 : 1;
+   q->open_seq[q->nr_open_seq++] = seq;
+   if (fence && base_fence.fd >= 0)
+      q->fences = 1;
+   pthread_mutex_unlock(&q->lock);
+
+   if (fence_fd)
+      *fence_fd = base_fence.fd;
+   return seq;
+}
+
+static bool
+seq_open_locked(const struct kbase_queue *q, uint64_t seq)
+{
+   for (unsigned k = 0; k < q->nr_open_seq; k++)
+      if (q->open_seq[k] <= seq)
+         return true;
+   return false;
+}
+
+void
+pan_kmod_kbase_wait_seq(struct pan_kmod_dev *dev, uint64_t seq)
+{
+   struct kbase_queue *q = &to_kdev(dev)->queue;
+
+   pthread_mutex_lock(&q->lock);
+   if (!seq)
+      seq = q->next_seq - 1;
+   while (seq_open_locked(q, seq))
+      pthread_cond_wait(&q->cond, &q->lock);
+   pthread_mutex_unlock(&q->lock);
+}
+
+bool
+pan_kmod_kbase_wait_seq_timeout(struct pan_kmod_dev *dev, uint64_t seq, int64_t abs_timeout_ns)
+{
+   struct kbase_queue *q = &to_kdev(dev)->queue;
+
+   if (!seq)
+      return true;
+
+   bool done = false;
+   pthread_mutex_lock(&q->lock);
+   for (;;) {
+      if (!seq_open_locked(q, seq)) {
+         done = true;
+         break;
+      }
+      if (abs_timeout_ns == INT64_MAX) {
+         pthread_cond_wait(&q->cond, &q->lock);
+         continue;
+      }
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      if ((int64_t)now.tv_sec * 1000000000ll + now.tv_nsec >= abs_timeout_ns)
+         break;
+      const struct timespec until = {.tv_sec = abs_timeout_ns / 1000000000ll,
+                                     .tv_nsec = abs_timeout_ns % 1000000000ll};
+      pthread_cond_timedwait(&q->cond, &q->lock, &until);
+   }
+   pthread_mutex_unlock(&q->lock);
+   return done;
+}
+
+static void
+kbase_blocking_done(void *data, bool ok)
+{
+   *(bool *)data = ok;
+}
+
+bool
+pan_kmod_kbase_submit(struct pan_kmod_dev *dev, const struct pan_kmod_kbase_atom *atoms,
+                      unsigned nr_atoms)
+{
+   bool ok = true;
+   const uint64_t seq =
+      pan_kmod_kbase_submit_async(dev, atoms, nr_atoms, NULL, kbase_blocking_done, &ok);
+   if (!seq)
+      return false;
+   pan_kmod_kbase_wait_seq(dev, seq);
+   return ok;
+}
+
+const struct pan_kmod_ops kbase_kmod_ops = {
+   .dev_create = kbase_kmod_dev_create,
+   .dev_destroy = kbase_kmod_dev_destroy,
+   .dev_query_user_va_range = kbase_kmod_dev_query_user_va_range,
+   .bo_alloc = kbase_kmod_bo_alloc,
+   .bo_free = kbase_kmod_bo_free,
+   .bo_import = kbase_kmod_bo_import,
+   .bo_export = kbase_kmod_bo_export,
+   .bo_mmap = kbase_kmod_bo_mmap,
+   .flush_bo_map_syncs = kbase_kmod_flush_bo_map_syncs,
+   .bo_wait = kbase_kmod_bo_wait,
+   .vm_create = kbase_kmod_vm_create,
+   .vm_destroy = kbase_kmod_vm_destroy,
+   .vm_bind = kbase_kmod_vm_bind,
+   .query_timestamp = kbase_kmod_query_timestamp,
+};
