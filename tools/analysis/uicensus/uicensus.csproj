<Project Sdk="Microsoft.NET.Sdk">
  <!-- UICensus.cs: .NET 3.5 (Unity 2017.x's Mono and newer), against the game's own UnityEngine.CoreModule.dll for the
       MonoBehaviour (compile only, $(UnityRef)); everything else by reflection. build.sh -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>uicensus</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UICensus.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityRef)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
