# box64 settings for Unity's Linux players: sourced by the launcher (launcher.sh.in) and the test
# rig (rig_inside.sh). `box64_profile <name>` prints VAR=value words; pass them on the game's command
# line (env, or westonwrap.sh's arguments), not as exports: Westonpack and some firmwares (ROCKNIX's
# BOX64_LD_LIBRARY_PATH) set their own values before the game starts.
#
#   safe     nothing: box64's own detection. On UnityPlayer.so (2019.x+ players) it sets
#            BOX64_UNITY=1 (STRONGMEM=1 on Linux); on libmonobdwgc (MonoBleedingEdge) it forces
#            BIGBLOCK=0 and STRONGMEM=1.
#   default  STRONGMEM=1 kept for the players' threads, the Mono override off so BIGBLOCK=2 applies:
#            on an H700 (RG35XX H) a 2019.4 Mono game ran 37-41 fps against 27-31 with box64's
#            Mono profile, no crashes (box64 0.4.4).
#   fast     also STRONGMEM=0, SAFEFLAGS=0, CALLRET=1, FORWARD=1024: a 2017.4 Mono game on an
#            H700 went from ~28 to 42-45 fps in its heaviest scenes. STRONGMEM=0 can break
#            lock-free code that relies on x86 memory ordering: test the whole game before making
#            it a port's default.
box64_profile() {
  case "${1:-default}" in
    safe) ;;
    default) echo BOX64_DYNAREC_BLEEDING_EDGE=0 BOX64_DYNAREC_STRONGMEM=1 BOX64_DYNAREC_BIGBLOCK=2 ;;
    fast) echo BOX64_DYNAREC_BLEEDING_EDGE=0 BOX64_UNITYPLAYER=0 BOX64_DYNAREC_STRONGMEM=0 BOX64_DYNAREC_BIGBLOCK=2 \
               BOX64_DYNAREC_SAFEFLAGS=0 BOX64_DYNAREC_CALLRET=1 BOX64_DYNAREC_FORWARD=1024 ;;
    *) echo "box64_profile: unknown profile $1 (safe, default, fast)" >&2 ;;
  esac
}
