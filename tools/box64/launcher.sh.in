#!/bin/bash
# PORTMASTER: @ZIP@, @SCRIPT@
# @TITLE@: the game's own Linux build (Unity @UNITY@, @BACKEND@) under box64.
# Made from portmaster-unity's tools/box64/launcher.sh.in (MIT). Fields: @TITLE@ @PORTDIR@ @EXE@
# @DATA@ (the <Game>_Data folder) @GL@ (gles | mesa | gl4es) @BOX64_PROFILE@ (safe | default | fast).
# The player can override in ports/@PORTDIR@/options.txt: PMU_GL, PMU_BOX64, PMU_ARGS, PMU_MAXCPU,
# PMU_DYNACACHE=0 (see docs/box64-route.md).

XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
if [ -d "/opt/system/Tools/PortMaster/" ]; then
  controlfolder="/opt/system/Tools/PortMaster"
elif [ -d "/opt/tools/PortMaster/" ]; then
  controlfolder="/opt/tools/PortMaster"
elif [ -d "$XDG_DATA_HOME/PortMaster/" ]; then
  controlfolder="$XDG_DATA_HOME/PortMaster"
else
  controlfolder="/roms/ports/PortMaster"
fi

source $controlfolder/control.txt
[ -f "${controlfolder}/mod_${CFW_NAME}.txt" ] && source "${controlfolder}/mod_${CFW_NAME}.txt"
get_controls

GAMEDIR=/$directory/ports/@PORTDIR@
DATADIR=$GAMEDIR/gamedata
EXE="@EXE@"
cd "$GAMEDIR"
> "$GAMEDIR/log.txt" && exec > >(tee "$GAMEDIR/log.txt") 2>&1
[ -f "$GAMEDIR/options.txt" ] && source "$GAMEDIR/options.txt"

if [ ! -f "$DATADIR/$EXE" ] || [ ! -d "$DATADIR/@DATA@" ]; then
  pm_message "Copy the game's Linux files ($EXE and @DATA@) into ports/@PORTDIR@/gamedata."
  sleep 5
  exit 1
fi
chmod +x "$GAMEDIR/box64/box64" "$DATADIR/$EXE"

# GL: gles  = Unity's OpenGL ES mode (-force-gles) through glxes on the firmware's GLES driver; the
#             data needs GLES 3 shaders (the port's setup: pmunity convert, tools/box64/gles.json)
#     mesa  = Unity's OpenGL Core renderer on a desktop-GL driver (Panfrost, Turnip): data as it is
#     gl4es = Unity's OpenGL 2 renderer (Unity 5.4 and older) through gl4es
GL=${PMU_GL:-@GL@}
ARGS=(-screen-fullscreen 1 -screen-width "$DISPLAY_WIDTH" -screen-height "$DISPLAY_HEIGHT" -logFile "$GAMEDIR/player.log")
case "$GL" in
  gles)  ARGS+=(-force-gles); GLENV=(BOX64_LIBGL="$GAMEDIR/glxes/libGL.so.1"); WESTON=(headless noop kiosk crusty_x11egl) ;;
  gl4es) ARGS+=(-force-opengl); GLENV=(LIBGL_NOBANNER=1); WESTON=(headless noop kiosk crusty_glx_gl4es) ;;
  mesa)  ARGS+=(-force-glcore); GLENV=(); WESTON=(drm gl kiosk system) ;;
  *)     pm_message "PMU_GL=$GL: gles, mesa or gl4es"; sleep 5; exit 1 ;;
esac
# shellcheck disable=SC2206
ARGS+=(${PMU_ARGS:-})

# box64: settings for Unity's players (box64.env), the x86_64 libraries box64 brings (x64lib), 4 cores
source "$GAMEDIR/box64/box64.env"
B64=($(box64_profile "${PMU_BOX64:-@BOX64_PROFILE@}") BOX64_LOG=1 BOX64_LD_LIBRARY_PATH="$GAMEDIR/box64/x64lib")
[ -n "${PMU_MAXCPU:-}" ] && B64+=(BOX64_MAXCPU="$PMU_MAXCPU")
# DynaCache (box64 0.4: on by default) keeps translated code between starts, in the port's folder
B64+=(BOX64_DYNACACHE="${PMU_DYNACACHE:-1}" BOX64_DYNACACHE_FOLDER="$GAMEDIR/conf/dynacache" BOX64_DYNACACHE_LIMIT=512)

# Saves and settings: Unity keeps them under $HOME/.config/unity3d/<company>/<product>
mkdir -p "$GAMEDIR/conf/dynacache"
source "$GAMEDIR/box64/unityprefs.sh"
unity_prefs_screen "$DATADIR/@DATA@" "$GAMEDIR/conf" "$DISPLAY_WIDTH" "$DISPLAY_HEIGHT"

# X11 for the player: PortMaster's Westonpack (Xwayland) where the firmware has no X server
weston_dir=/tmp/weston
weston_runtime="weston_pkg_0.2"
if [ ! -f "$controlfolder/libs/${weston_runtime}.squashfs" ]; then
  if [ ! -f "$controlfolder/harbourmaster" ]; then
    pm_message "This port requires the latest PortMaster to run, please go to https://portmaster.games/ for more info."
    sleep 5
    exit 1
  fi
  $ESUDO $controlfolder/harbourmaster --quiet --no-check runtime_check "${weston_runtime}.squashfs"
fi
$ESUDO mkdir -p "$weston_dir"
[[ "$PM_CAN_MOUNT" != "N" ]] && $ESUDO umount "$weston_dir" 2>/dev/null
$ESUDO mount "$controlfolder/libs/${weston_runtime}.squashfs" "$weston_dir"

# keys and mouse for games that want them: ports/@PORTDIR@/@PORTDIR@.gptk (also the exit hotkey)
$GPTOKEYB "$EXE" -c "$GAMEDIR/@PORTDIR@.gptk" &
pm_platform_helper "$GAMEDIR/box64/box64"
cd "$DATADIR"
# box64's and the GL settings go on westonwrap's command line: it reloads PortMaster's settings
# before it starts the game, and some firmwares (ROCKNIX) export their own BOX64_LD_LIBRARY_PATH
$ESUDO env $weston_dir/westonwrap.sh "${WESTON[@]}" \
  "${B64[@]}" "${GLENV[@]}" HOME="$GAMEDIR/conf" XDG_CONFIG_HOME="$GAMEDIR/conf/.config" \
  "$GAMEDIR/box64/box64" "./$EXE" "${ARGS[@]}"

$ESUDO $weston_dir/westonwrap.sh cleanup
[[ "$PM_CAN_MOUNT" != "N" ]] && $ESUDO umount "$weston_dir"
pm_finish
