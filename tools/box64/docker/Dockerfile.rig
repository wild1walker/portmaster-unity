# Emulated handheld for the box64 route (tools/box64/rig.sh): arm64 Debian 12 with Xvfb and Mesa
# (llvmpipe: desktop GL 4.5 and GLES 3.2 in software), SDL2, ALSA/PulseAudio client libraries, the
# X11 libraries Unity's Linux player opens, and xdotool/ImageMagick for input and screenshots.
# box64 and gl4es come from tools/box64/build.sh (mounted, not installed).
FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates xvfb xauth x11-utils xdotool imagemagick mesa-utils mesa-utils-bin \
      libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 libgles2 libgbm1 \
      libx11-6 libxext6 libxcursor1 libxrandr2 libxi6 libxinerama1 libxxf86vm1 libxss1 libxrender1 \
      libasound2 libasound2-plugins libpulse0 libudev1 libsdl2-2.0-0 \
      gcc libc6-dev procps python3 python3-pip python3-evdev udev file strace less \
 && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
      libx11-xcb1 libxkbcommon0 libwayland-client0 libwayland-cursor0 libwayland-egl1 libdbus-1-3 \
      libegl-mesa0 pulseaudio \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
