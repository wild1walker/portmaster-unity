# Emulated handheld for the box64 route (tools/box64/rig.sh): arm64 Debian 12 (slim) with Xvfb and
# Mesa (llvmpipe: desktop GL 4.5 and GLES 3.2 in software), the X11 and other libraries Unity's
# Linux player opens, xdotool (input) and xwd (screenshots). About 350 MB, most of it LLVM for
# llvmpipe; no sound server (a PulseAudio server would bring ~100 MB of codecs: the players then run
# FMOD's no-sound output). box64, gl4es, glxes and the game come in bind mounts, nothing is built here.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-apps xdotool procps \
      libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 libegl-mesa0 libgles2 \
      libx11-6 libx11-xcb1 libxext6 libxcursor1 libxrandr2 libxi6 libxinerama1 libxxf86vm1 libxss1 libxrender1 \
      libxkbcommon0 libwayland-client0 libwayland-cursor0 libwayland-egl1 libdbus-1-3 libudev1 libasound2 libpulse0 \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/locale
WORKDIR /work
